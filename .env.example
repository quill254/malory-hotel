# ============================================================
# MALORY — environment configuration
# Every secret is masked with ***. Copy to .env.local and replace.
# Never commit .env.local. Never expose these in client-side code.
# ============================================================

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://[DOMAIN-TBD].vercel.app   # replace with final domain at launch
HOTEL_TIMEZONE=Africa/Nairobi

# ---- Booking engine (Cloudbeds or Pesapal ReservePort — TBD) ----
BOOKING_ENGINE=cloudbeds                        # cloudbeds | pesapal
BOOKING_ENGINE_API_KEY=************************
BOOKING_ENGINE_PROPERTY_ID=********************
BOOKING_ENGINE_WEBHOOK_SECRET=******************

# ---- Payments: M-Pesa (Safaricom Daraja) ----
MPESA_ENV=sandbox                               # sandbox | production
MPESA_CONSUMER_KEY=************************
MPESA_CONSUMER_SECRET=************************
MPESA_SHORTCODE=********                        # till / paybill
MPESA_PASSKEY=********************************
MPESA_CALLBACK_URL=https://[DOMAIN-TBD]/api/webhooks/payment

# ---- Payments: cards (gateway TBD — DPO / Flutterwave / Pesapal) ----
CARD_GATEWAY=***********************************
CARD_GATEWAY_PUBLIC_KEY=************************
CARD_GATEWAY_SECRET_KEY=************************
CARD_GATEWAY_WEBHOOK_SECRET=********************

# ---- Email / SMS notifications (provider TBD — Resend / Twilio / Africa's Talking) ----
EMAIL_API_KEY=**********************************
EMAIL_FROM="Malory Reservations <bookings@[DOMAIN-TBD]>"
SMS_API_KEY=************************************
SMS_SENDER_ID=******                            # registered sender ID

# ---- Google ----
NEXT_PUBLIC_GA4_ID=G-**********                 # Google Analytics 4
NEXT_PUBLIC_GTM_ID=GTM-*******                  # optional, if used
GOOGLE_SITE_VERIFICATION=************************  # Search Console HTML tag

# ---- Database (production booking records / enquiries — Supabase/Neon/Postgres TBD) ----
DATABASE_URL=postgres://********:********@********/********
